# Legacy backend only. The website uses assets/js/supabase-config.js.
# Copy to .env only for an explicitly approved local legacy investigation.
PORT=5000
NODE_ENV=development
# Generate at least 32 random bytes; no shared/default JWT secret is supported.
JWT_SECRET=
# Public Supabase connection settings (never use a service-role/secret key here).
SUPABASE_URL=
SUPABASE_ANON_KEY=
